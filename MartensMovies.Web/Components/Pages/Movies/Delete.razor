@page "/movies/delete/{Id:guid}"
@using MartensMovies.Web.Movies
@using Marten
@using Wolverine
@inject IQuerySession Session
@inject IMessageBus Bus
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>Delete Movie</PageTitle>

<h1>Delete</h1>
<h3>Are you sure you want to delete this?</h3>

@if (movie is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <dl class="row">
        <dt class="col-sm-2">Title</dt><dd class="col-sm-10">@movie.Title</dd>
        <dt class="col-sm-2">Release Date</dt><dd class="col-sm-10">@movie.ReleaseDate.ToString("yyyy-MM-dd")</dd>
        <dt class="col-sm-2">Genre</dt><dd class="col-sm-10">@movie.Genre</dd>
        <dt class="col-sm-2">Price</dt><dd class="col-sm-10">@movie.Price.ToString("C")</dd>
        <dt class="col-sm-2">Rating</dt><dd class="col-sm-10">@movie.Rating</dd>
    </dl>
    <button class="btn btn-danger" @onclick="Confirm">Delete</button>
    <a class="btn btn-link" href="/movies">Back to list</a>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private Movie? movie;

    protected override async Task OnParametersSetAsync()
    {
        movie = await Session.LoadAsync<Movie>(Id);
    }

    private async Task Confirm()
    {
        await Bus.InvokeAsync(new DeleteMovie(Id));
        Nav.NavigateTo("/movies");
    }
}
